import cv2
import mediapipe as mp
import math
import serial
import time

# ================= SERIAL =================
arduino = serial.Serial('COM3', 9600)
time.sleep(2)
last_send = 0

# ================= MEDIAPIPE =================
mp_hands = mp.solutions.hands
hands = mp_hands.Hands(
    max_num_hands=1,
    min_detection_confidence=0.7,
    min_tracking_confidence=0.7
)

mp_draw = mp.solutions.drawing_utils
cap = cv2.VideoCapture(0)

# ================= CALIBRATION =================
CALIBRATION_FRAMES = 180
calibration_counter = 0
calibrated = False

prev_values = [0] * 9
alpha = 0.3

MIN_DIST = {
    "index": 1e9,
    "middle": 1e9,
    "ring": 1e9,
    "pinky": 1e9,
    "thumb": 1e9,
    "abd_index": 1e9,
    "abd_middle": 1e9,
    "abd_ring": 1e9,
    "abd_pinky": 1e9,
}

MAX_DIST = {
    "index": 0,
    "middle": 0,
    "ring": 0,
    "pinky": 0,
    "thumb": 0,
    "abd_index": 0,
    "abd_middle": 0,
    "abd_ring": 0,
    "abd_pinky": 0,
}

# ================= LANDMARKS =================
LAND_MARKS_TIP = {
    "thumb_tip": 4,
    "index_finger_tip": 8,
    "middle_finger_tip": 12,
    "ring_finger_tip": 16,
    "pinky_finger_tip": 20
}

LAND_MARKS_BASE = {
    "thumb_base": 1,
    "index_finger_base": 5,
    "middle_finger_base": 9,
    "ring_finger_base": 13,
    "pinky_finger_base": 17,
    "wrist": 0
}

# ================= SAFE FUNCTIONS =================
def safe(x):
    if x is None or math.isnan(x) or math.isinf(x):
        return 0
    return x


def proportions(d1, d2):
    if d2 < 1e-6:
        return 0
    return safe(d1 / d2)


def map_value(val, in_min, in_max, out_min, out_max):
    val = safe(val)
    if in_min == in_max:
        return out_min
    val = max(in_min, min(val, in_max))
    return int((val - in_min) * (out_max - out_min) / (in_max - in_min) + out_min)


# ================= DIST =================
def dist(base, tip, fingers_base, fingers_tip):
    if base not in fingers_base or tip not in fingers_tip:
        return 0
    return math.hypot(
        fingers_base[base][0] - fingers_tip[tip][0],
        fingers_base[base][1] - fingers_tip[tip][1]
    )


# ================= THUMB FLEXION (NUOVO - basato su X) =================
def thumb_flexion_x(thumb_tip_pos, index_base_pos, pinky_base_pos, wrist_pos):
    """
    Calcola la flessione del pollice basata sulla posizione X.

    Fase 1 (chiuso verso l'interno):
      thumb_tip.x < index_base.x → angolo = 180° (clamp)

    Fase 2 (aperto/esterno):
      thumb_tip.x >= index_base.x → angolo riparte da 0°

    Fase 3 (chiuso verso il mignolo):
      thumb_tip.x supera pinky_base.x → angolo arriva a 180°

    Ritorna: valore da mappare (distanza X normalizzata)
             e flag se è nella fase "chiuso verso interno"
    """
    # Determina direzione della mano (1 = mano destra, -1 = mano sinistra)
    # Dopo cv2.flip(img, 1), la mano destra appare con polso a sinistra
    hand_direction = 1 if wrist_pos[0] < index_base_pos[0] else -1

    # Distanza thumb_tip da index_base nella direzione dell'interno
    dx_from_index = (thumb_tip_pos[0] - index_base_pos[0]) * hand_direction

    # Distanza thumb_tip da pinky_base nella direzione dell'interno
    dx_from_pinky = (thumb_tip_pos[0] - pinky_base_pos[0]) * hand_direction

    # Se thumb_tip è oltre index_base verso l'interno (dx_from_index < 0)
    # → pollice chiuso verso il palmo
    if dx_from_index < 0:
        return None, True  # None = usa clamp 180, True = chiuso verso interno

    # Altrimenti: thumb_tip è esterno o verso il mignolo
    # Calcoliamo la distanza totale da index_base a pinky_base
    span = (pinky_base_pos[0] - index_base_pos[0]) * hand_direction

    if span == 0:
        return 0, False

    # Normalizza: 0 = a index_base, 1 = a pinky_base
    # dx_from_index è >= 0 qui
    normalized = dx_from_index / span

    return normalized, False


def is_thumb_closed_inward(thumb_tip_pos, index_base_pos, wrist_pos):
    """
    Verifica se il pollice è chiuso verso l'interno (palmo).
    True se thumb_tip.x < index_base.x (verso l'interno).
    """
    hand_direction = 1 if wrist_pos[0] < index_base_pos[0] else -1
    dx = (thumb_tip_pos[0] - index_base_pos[0]) * hand_direction
    return dx < 0


# ================= CHECK FINGER FULLY CLOSED (Y-axis) =================
def is_finger_closed(tip_pos, base_pos, wrist_pos):
    v_base_to_wrist = (wrist_pos[0] - base_pos[0], wrist_pos[1] - base_pos[1])
    v_base_to_tip = (tip_pos[0] - base_pos[0], tip_pos[1] - base_pos[1])
    dot = v_base_to_wrist[0] * v_base_to_tip[0] + v_base_to_wrist[1] * v_base_to_tip[1]
    return dot > 0


# ================= ABDUZIONE INDIVIDUALE =================
def finger_abduction_angle(base_point, tip_target, tip_reference):
    v_target = (tip_target[0] - base_point[0], tip_target[1] - base_point[1])
    v_ref = (tip_reference[0] - base_point[0], tip_reference[1] - base_point[1])
    mag_target = math.hypot(v_target[0], v_target[1])
    mag_ref = math.hypot(v_ref[0], v_ref[1])
    if mag_target < 1e-6 or mag_ref < 1e-6:
        return 0
    dot = v_target[0] * v_ref[0] + v_target[1] * v_ref[1]
    cos_angle = max(-1, min(1, dot / (mag_target * mag_ref)))
    return math.degrees(math.acos(cos_angle))


# ================= DRAW BARS =================
def draw_bar(img, x, y, w, h, value, max_val, label, color):
    ratio = min(1.0, max(0.0, value / max_val))
    fill_w = int(w * ratio)
    cv2.rectangle(img, (x, y), (x + w, y + h), (50, 50, 50), -1)
    cv2.rectangle(img, (x, y), (x + fill_w, y + h), color, -1)
    cv2.rectangle(img, (x, y), (x + w, y + h), (200, 200, 200), 1)
    cv2.putText(img, f"{label}: {value}", (x, y - 5),
                cv2.FONT_HERSHEY_SIMPLEX, 0.45, color, 1)


def draw_debug_panel(img, values, closed_flags, thumb_phase, h, w):
    labels = ["Index", "Middle", "Ring", "Pinky", "Thumb", 
              "Abd Index", "Abd Middle", "Abd Ring", "Abd Pinky"]
    colors = [
        (0, 165, 255), (0, 255, 255), (0, 255, 0), (255, 0, 0), (0, 0, 255),
        (255, 0, 255), (255, 255, 0), (128, 0, 128), (0, 128, 255),
    ]

    panel_x = 10
    panel_y = 80
    bar_w = 200
    bar_h = 18
    gap = 28

    cv2.putText(img, "=== DEBUG PANEL ===", (panel_x, panel_y - 15),
                cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)

    for i, (val, label, color) in enumerate(zip(values, labels, colors)):
        y_pos = panel_y + i * gap
        max_val = 90 if i >= 5 else 180
        draw_bar(img, panel_x, y_pos, bar_w, bar_h, val, max_val, label, color)

        if i < 5 and closed_flags[i]:
            cv2.putText(img, "[CLAMPED]", (panel_x + bar_w + 10, y_pos + 14),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.4, (0, 0, 255), 1)

    # Stato pollice
    status_y = panel_y + len(values) * gap + 20
    cv2.putText(img, "=== THUMB PHASE ===", (panel_x, status_y),
                cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)

    if thumb_phase == 0:
        phase_text = "CLOSED inward (180)"
        phase_color = (0, 0, 255)
    elif thumb_phase == 1:
        phase_text = "OPEN (0-180)"
        phase_color = (0, 255, 0)
    else:
        phase_text = "CLOSED toward pinky (180)"
        phase_color = (0, 0, 255)

    cv2.putText(img, phase_text, (panel_x, status_y + 25),
                cv2.FONT_HERSHEY_SIMPLEX, 0.5, phase_color, 1)

    # Stato dita
    status_y2 = status_y + 50
    cv2.putText(img, "=== FINGER STATUS ===", (panel_x, status_y2),
                cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)

    finger_names = ["Index", "Middle", "Ring", "Pinky", "Thumb"]
    for i, name in enumerate(finger_names):
        angle = values[i]
        if closed_flags[i]:
            status = "CLOSED [MAX]"
            color = (0, 0, 255)
        else:
            status = "OPEN" if angle < 90 else "CLOSED"
            color = (0, 255, 0) if angle < 90 else (0, 0, 255)
        cv2.putText(img, f"{name}: {status} ({angle}°)", 
                    (panel_x, status_y2 + 25 + i * 22),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 1)

    abd_y = status_y2 + 25 + len(finger_names) * 22 + 10
    cv2.putText(img, "=== ABDUCTION (individual) ===", (panel_x, abd_y),
                cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)
    abd_labels = ["Index", "Middle", "Ring", "Pinky"]
    for i, label in enumerate(abd_labels):
        angle = values[5 + i]
        status = "SPREAD" if angle > 20 else "CLOSE"
        color = (0, 255, 0) if angle > 20 else (0, 0, 255)
        cv2.putText(img, f"{label}: {status} ({angle}°)", 
                    (panel_x, abd_y + 20 + i * 20),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.45, color, 1)


# ================= MAIN LOOP =================
while True:

    success, img = cap.read()
    if not success:
        break

    img = cv2.flip(img, 1)
    h, w, _ = img.shape

    rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    results = hands.process(rgb)

    if results.multi_hand_landmarks:

        for handLms in results.multi_hand_landmarks:

            fingers_tip = {
                k: (int(handLms.landmark[i].x * w), int(handLms.landmark[i].y * h))
                for k, i in LAND_MARKS_TIP.items()
            }

            fingers_base = {
                k: (int(handLms.landmark[i].x * w), int(handLms.landmark[i].y * h))
                for k, i in LAND_MARKS_BASE.items()
            }

            wrist = fingers_base["wrist"]

            # ================= CHECK FINGERS CLOSED =================
            closed_index = is_finger_closed(
                fingers_tip["index_finger_tip"], 
                fingers_base["index_finger_base"], 
                wrist
            )
            closed_middle = is_finger_closed(
                fingers_tip["middle_finger_tip"], 
                fingers_base["middle_finger_base"], 
                wrist
            )
            closed_ring = is_finger_closed(
                fingers_tip["ring_finger_tip"], 
                fingers_base["ring_finger_base"], 
                wrist
            )
            closed_pinky = is_finger_closed(
                fingers_tip["pinky_finger_tip"], 
                fingers_base["pinky_finger_base"], 
                wrist
            )

            # Pollice: check chiuso verso interno
            closed_thumb_inward = is_thumb_closed_inward(
                fingers_tip["thumb_tip"],
                fingers_base["index_finger_base"],
                wrist
            )

            closed_flags = [closed_index, closed_middle, closed_ring, closed_pinky, closed_thumb_inward]

            # ================= FLEXION =================
            feedback = dist("wrist", "middle_finger_tip", fingers_base, fingers_tip)

            a = proportions(dist("index_finger_base", "index_finger_tip", fingers_base, fingers_tip), feedback)
            b = proportions(dist("middle_finger_base", "middle_finger_tip", fingers_base, fingers_tip), feedback)
            c = proportions(dist("ring_finger_base", "ring_finger_tip", fingers_base, fingers_tip), feedback)
            d = proportions(dist("pinky_finger_base", "pinky_finger_tip", fingers_base, fingers_tip), feedback)

            if any(math.isnan(x) for x in [a, b, c, d]):
                continue

            # ================= THUMB (NUOVO - 3 fasi) =================
            thumb_norm, thumb_is_inward = thumb_flexion_x(
                fingers_tip["thumb_tip"],
                fingers_base["index_finger_base"],
                fingers_base["pinky_finger_base"],
                wrist
            )

            # ================= ABDUZIONE INDIVIDUALE =================
            abd_index = finger_abduction_angle(
                wrist,
                fingers_tip["index_finger_tip"],
                fingers_tip["middle_finger_tip"]
            )
            abd_middle_ind = finger_abduction_angle(
                wrist,
                fingers_tip["middle_finger_tip"],
                fingers_tip["index_finger_tip"]
            )
            abd_middle_ring = finger_abduction_angle(
                wrist,
                fingers_tip["middle_finger_tip"],
                fingers_tip["ring_finger_tip"]
            )
            abd_middle = (abd_middle_ind + abd_middle_ring) / 2
            abd_ring = finger_abduction_angle(
                wrist,
                fingers_tip["ring_finger_tip"],
                fingers_tip["middle_finger_tip"]
            )
            abd_pinky = finger_abduction_angle(
                wrist,
                fingers_tip["pinky_finger_tip"],
                fingers_tip["ring_finger_tip"]
            )

            # ================= CALIBRATION =================
            if not calibrated:

                calibration_counter += 1

                for key, val in zip(
                    ["index", "middle", "ring", "pinky"],
                    [a, b, c, d]
                ):
                    MIN_DIST[key] = min(MIN_DIST[key], val)
                    MAX_DIST[key] = max(MAX_DIST[key], val)

                # Calibrazione pollice: salva valore normalizzato
                if thumb_norm is not None:
                    MIN_DIST["thumb"] = min(MIN_DIST["thumb"], thumb_norm)
                    MAX_DIST["thumb"] = max(MAX_DIST["thumb"], thumb_norm)

                MIN_DIST["abd_index"] = min(MIN_DIST["abd_index"], abd_index)
                MAX_DIST["abd_index"] = max(MAX_DIST["abd_index"], abd_index)
                MIN_DIST["abd_middle"] = min(MIN_DIST["abd_middle"], abd_middle)
                MAX_DIST["abd_middle"] = max(MAX_DIST["abd_middle"], abd_middle)
                MIN_DIST["abd_ring"] = min(MIN_DIST["abd_ring"], abd_ring)
                MAX_DIST["abd_ring"] = max(MAX_DIST["abd_ring"], abd_ring)
                MIN_DIST["abd_pinky"] = min(MIN_DIST["abd_pinky"], abd_pinky)
                MAX_DIST["abd_pinky"] = max(MAX_DIST["abd_pinky"], abd_pinky)

                cv2.putText(img, f"CALIBRATING {calibration_counter}/{CALIBRATION_FRAMES}",
                            (10, 50), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)
                cv2.putText(img, "SPREAD fingers wide, then close together", (10, h - 40),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 255), 1)

                if calibration_counter >= CALIBRATION_FRAMES:
                    calibrated = True
                    print("Calibration complete")
                    print(f"Thumb range: {MIN_DIST['thumb']:.3f} to {MAX_DIST['thumb']:.3f}")

                continue

            # ================= ANGLES =================
            index_angle = map_value(a, MIN_DIST["index"], MAX_DIST["index"], 180, 0)
            middle_angle = map_value(b, MIN_DIST["middle"], MAX_DIST["middle"], 180, 0)
            ring_angle = map_value(c, MIN_DIST["ring"], MAX_DIST["ring"], 180, 0)
            pinky_angle = map_value(d, MIN_DIST["pinky"], MAX_DIST["pinky"], 180, 0)

            # ================= THUMB ANGLE (3 FASI) =================
            if thumb_is_inward:
                # FASE 0: Pollice chiuso verso l'interno (palmo)
                thumb_angle = 180
                thumb_phase = 0
            elif thumb_norm is not None:
                # FASE 1-2: Pollice esterno, da index_base a pinky_base
                thumb_angle = map_value(thumb_norm, MIN_DIST["thumb"], MAX_DIST["thumb"], 0, 180)
                thumb_phase = 1 if thumb_angle < 180 else 2
            else:
                thumb_angle = 180
                thumb_phase = 0

            # ================= CLAMP A 180 QUANDO CHIUSE =================
            if closed_index:
                index_angle = 180
            if closed_middle:
                middle_angle = 180
            if closed_ring:
                ring_angle = 180
            if closed_pinky:
                pinky_angle = 180
            # Il pollice ha già il suo clamp integrato nelle 3 fasi

            # ================= ABDUZIONE MAPPATA =================
            abd_index_val = map_value(abd_index, MIN_DIST["abd_index"], MAX_DIST["abd_index"], 90, 0)
            abd_middle_val = map_value(abd_middle, MIN_DIST["abd_middle"], MAX_DIST["abd_middle"], 0, 30)
            abd_ring_val = map_value(abd_ring, MIN_DIST["abd_ring"], MAX_DIST["abd_ring"], 0, 40)
            abd_pinky_val = map_value(abd_pinky, MIN_DIST["abd_pinky"], MAX_DIST["abd_pinky"], 0, 50)

            # ================= OUTPUT =================
            values = [
                index_angle,      # 0
                middle_angle,     # 1
                ring_angle,       # 2
                pinky_angle,      # 3
                thumb_angle,      # 4
                abd_index_val,    # 5
                abd_middle_val,   # 6
                abd_ring_val,     # 7
                abd_pinky_val,    # 8
            ]

            # ================= SMOOTHING =================
            for i in range(len(values)):
                values[i] = int(alpha * values[i] + (1 - alpha) * prev_values[i])

            prev_values = values.copy()

            print(*values)

            #================= SERIAL =================
            if time.time() - last_send > 0.05:
                try:
                    arduino.write(f"{','.join(map(str, values))}\n".encode())
                    last_send = time.time()
                except:
                    pass

            # ================= DEBUG VISIVO =================
            if calibrated:
                draw_debug_panel(img, values, closed_flags, thumb_phase, h, w)

            if not calibrated:
                cv2.putText(img, "MOVE HAND: open/close + spread/close fingers", (10, h - 20),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 255), 1)

            mp_draw.draw_landmarks(img, handLms, mp_hands.HAND_CONNECTIONS)

    else:
        cv2.putText(img, "NO HAND DETECTED", (w//2 - 120, h//2),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 0, 255), 2)

    cv2.imshow("Hand Tracking - Thumb 3 Phases", img)

    key = cv2.waitKey(1) & 0xFF
    if key == 27:
        break
    elif key == ord('r'):
        calibrated = False
        calibration_counter = 0
        MIN_DIST = {k: 1e9 for k in MIN_DIST}
        MAX_DIST = {k: 0 for k in MAX_DIST}
        prev_values = [0] * 9
        print("Calibration reset")

cap.release()
arduino.close()
cv2.destroyAllWindows()
